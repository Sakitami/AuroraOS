// The ARM11 job: one Game Boy frame, with Peanut-GB built for the ARM11.
// AuroraOS's core runs it (AUDIO_CMD_RUN11, src/os/Run11.c) with the MMU,
// the L1 caches and branch prediction on and interrupts off, and cleans its
// data cache before it answers. An exception here hangs the core, so there are
// no unaligned accesses (-mno-unaligned-access) and Peanut-GB's errors leave
// through __builtin_longjmp.
//
// The file is .c11, not .c, so that aurcc, which builds every .c in a folder
// for the ARM9, leaves it to build.py. Nothing clears memory for the job, so
// it has no .bss (job11.ld checks): what it keeps between frames is in the
// app's Gb11Job, and the few statics it needs are in .data.
#include <stddef.h>
#include <stdint.h>

#include "gb11.h"

uint8_t audio_read(uint16_t addr);
void audio_write(uint16_t addr, uint8_t val);

#define ENABLE_SOUND 1
#define ENABLE_LCD 1
#pragma GCC diagnostic push
#pragma GCC diagnostic ignored "-Wunused-parameter"
#pragma GCC diagnostic ignored "-Wsign-compare"
#pragma GCC diagnostic ignored "-Wimplicit-fallthrough"
#pragma GCC diagnostic ignored "-Wdeprecated-declarations"
#include "../peanut_gb.h"
#undef MIN // minigb_apu has its own
#include "../apu_config.h"
#include "../minigb_apu.inc"
#pragma GCC diagnostic pop

#define GB_W LCD_WIDTH
#define GB_H LCD_HEIGHT

#ifdef __arm__
#define DATA __attribute__((section(".data")))
#define ENTRY __attribute__((section(".text.entry")))
#else // a PC test build: ELF section names mean nothing there
#define DATA
#define ENTRY
#endif
static Gb11Job *job DATA;
static struct minigb_apu_ctx *apu DATA;

// A PC test build (clang has no __builtin_longjmp for every target) uses the
// C library's.
#ifdef __arm__
static void *err_jmp[5] DATA;
#define JOB_SETJMP() __builtin_setjmp(err_jmp)
#define JOB_LONGJMP() __builtin_longjmp(err_jmp, 1)
#else
#include <setjmp.h>
static jmp_buf err_jmp;
#define JOB_SETJMP() setjmp(err_jmp)
#define JOB_LONGJMP() longjmp(err_jmp, 1)
#endif

#ifdef __arm__
// No C library behind the job; Peanut-GB and minigb_apu call these, and the
// compiler may too (-fno-tree-loop-distribute-patterns keeps it from turning
// these loops into calls to themselves).
void *memset(void *d, int c, size_t n) {
  uint8_t *p = d;
  while (n--)
    *p++ = (uint8_t)c;
  return d;
}

void *memcpy(void *d, const void *s, size_t n) {
  uint8_t *p = d;
  const uint8_t *q = s;
  while (n--)
    *p++ = *q++;
  return d;
}
#endif

uint8_t audio_read(uint16_t addr) { return minigb_apu_audio_read(apu, addr); }

void audio_write(uint16_t addr, uint8_t val) {
  minigb_apu_audio_write(apu, addr, val);
}

static uint8_t rom_read(struct gb_s *g, const uint_fast32_t addr) {
  (void)g;
  return addr < job->rom_size ? job->rom[addr] : 0xFF;
}

static uint8_t ram_read(struct gb_s *g, const uint_fast32_t addr) {
  (void)g;
  return addr < job->cart_ram_size ? job->cart_ram[addr] : 0xFF;
}

static void ram_write(struct gb_s *g, const uint_fast32_t addr,
                      const uint8_t val) {
  (void)g;
  if (addr < job->cart_ram_size && job->cart_ram[addr] != val) {
    job->cart_ram[addr] = val;
    job->ram_written = 1;
  }
}

static void emu_error(struct gb_s *g, const enum gb_error_e err,
                      const uint16_t addr) {
  (void)g;
  job->error = 1u + (uint32_t)err;
  job->error_addr = addr;
  JOB_LONGJMP();
}

// As main.c's draw_line(): column x holds the frame's GB_H rows, each a
// palette entry (layer * 4 + shade). The ARM11's cache takes the writes, so
// they go straight in.
static void draw_line(struct gb_s *g, const uint8_t *px,
                      const uint_fast8_t line) {
  uint8_t *col = job->lcd + line;
  (void)g;
  if (line >= GB_H)
    return;
  for (int x = 0; x < GB_W; x++, col += GB_H)
    *col = (uint8_t)(((px[x] & 0x30) >> 2) | (px[x] & 3));
  if (line == GB_H - 1)
    job->frame_ready = 1;
}

ENTRY uint32_t gb11_entry(Gb11Job *j) {
  struct gb_s *gb = j->gb;

  j->gb_size = sizeof(struct gb_s);
  j->apu_size = sizeof(struct minigb_apu_ctx);
  if (j->probe) {
    j->ran = 1;
    return 0;
  }
  job = j;
  apu = j->apu;
  j->frame_ready = 0;
  j->ram_written = 0;
  j->error = 0;

  // The app's own callbacks are ARM9 code; these are this job's. The app
  // puts its own back afterwards.
  gb->gb_rom_read = rom_read;
  gb->gb_cart_ram_read = ram_read;
  gb->gb_cart_ram_write = ram_write;
  gb->gb_error = emu_error;
  gb->display.lcd_draw_line = j->draw ? draw_line : NULL;
  gb->direct.priv = NULL;

  if (JOB_SETJMP() == 0)
    gb_run_frame(gb);
  j->ran = 1;
  return j->error;
}
